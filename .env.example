# LexiDeck - Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha as chaves dos provedores que desejar utilizar.

# OpenAI API Key (obrigatório se --provider openai)
OPENAI_API_KEY=sua-chave-openai-aqui

# Google Gemini API Key (obrigatório se --provider gemini)
GEMINI_API_KEY=sua-chave-gemini-aqui

# Anthropic Claude API Key (obrigatório se --provider claude)
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui

